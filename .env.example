# Copy this file to .env and fill in the values. Never commit .env.
# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# Owner (used by the seed script and the test email)
OWNER_NAME=
OWNER_EMAIL=
# Email provider: gmail (send from the owner's Gmail, uses the Google sign-in below)
# or resend (needs RESEND_API_KEY; without a verified domain it only reaches your own address)
EMAIL_PROVIDER=gmail
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Database
POSTGRES_USER=assistant
POSTGRES_PASSWORD=
POSTGRES_DB=assistant
DATABASE_URL=postgresql+psycopg://assistant:CHANGE_ME@db:5432/assistant
# LLM (any OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# USD per 1M tokens for cost_usd in llm_calls; check your provider's current prices.
# LLM_PRICES={"deepseek-chat": {"input": 0.27, "cached_input": 0.07, "output": 1.10}}
# Google sign-in (Calendar, and Gmail when EMAIL_PROVIDER=gmail); filled by scripts/google_auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Token budgets (prompt + completion tokens per Tehran day / month; 0 = off). The owner gets a
# Telegram alert at 80% and 100%; BUDGET_HARD_STOP=true makes the bot refuse new requests at 100%.
DAILY_TOKEN_BUDGET=300000
MONTHLY_TOKEN_BUDGET=6000000
BUDGET_HARD_STOP=false
# Dashboard (owner only, http://127.0.0.1:8080; DASHBOARD_HOST behind the reverse proxy)
# Password hash: docker compose run --rm -it --no-deps dashboard python -m app.dashboard.auth
DASHBOARD_PASSWORD_HASH=
# Signs the session cookie: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET_KEY=
# true when served over HTTPS (production behind the proxy)
DASHBOARD_COOKIE_SECURE=false
# Read-only DB role, created by the migrate service when DASHBOARD_DB_PASSWORD is set
DASHBOARD_DB_USER=dashboard_ro
DASHBOARD_DB_PASSWORD=
DASHBOARD_DATABASE_URL=postgresql+psycopg://dashboard_ro:CHANGE_ME@db:5432/assistant
# Public subdomain for the dashboard, e.g. usage.example.com: needs a DNS A record to this server,
# then: docker compose --profile proxy up -d   (Caddy, automatic HTTPS; set DASHBOARD_COOKIE_SECURE=true)
DASHBOARD_HOST=
# Admin API: send this in the X-API-Key header (empty = every admin endpoint answers 401).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# DEBUG=true also serves the OpenAPI docs at /docs
DEBUG=false
# Speech to text
VOSK_MODEL_PATH=/opt/vosk-model
STT_MIN_CONFIDENCE=0.5
# Where downloaded voice files are stored inside the container
VOICE_DIR=/app/data/voice
# Bot limits: messages per user per minute, longest accepted voice message
RATE_LIMIT_PER_MINUTE=10
MAX_VOICE_SECONDS=60
# Leftover audio older than AUDIO_MAX_AGE_S is deleted every AUDIO_CLEANUP_INTERVAL_S
AUDIO_MAX_AGE_S=3600
AUDIO_CLEANUP_INTERVAL_S=600
