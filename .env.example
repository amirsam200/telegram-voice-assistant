# Copy this file to .env and fill in the values. Never commit .env.
# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# Owner (used by the seed script and the test email)
OWNER_NAME=
OWNER_EMAIL=
# Email provider: gmail (send from the owner's Gmail, uses the Google sign-in below)
# or resend (needs RESEND_API_KEY; without a verified domain it only reaches your own address)
EMAIL_PROVIDER=gmail
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Database
POSTGRES_USER=assistant
POSTGRES_PASSWORD=
POSTGRES_DB=assistant
DATABASE_URL=postgresql+psycopg://assistant:CHANGE_ME@db:5432/assistant
# LLM (any OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Google sign-in (Calendar, and Gmail when EMAIL_PROVIDER=gmail); filled by scripts/google_auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# API (prompt 3)
ADMIN_API_KEY=
DEBUG=false
# Speech to text
VOSK_MODEL_PATH=/opt/vosk-model
STT_MIN_CONFIDENCE=0.5
# Where downloaded voice files are stored inside the container
VOICE_DIR=/app/data/voice
