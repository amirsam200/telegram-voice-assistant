# Copy this file to .env and fill in the values. Never commit .env.
# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# Owner (used by the seed script and the test email)
OWNER_NAME=
OWNER_EMAIL=
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Database
POSTGRES_USER=assistant
POSTGRES_PASSWORD=
POSTGRES_DB=assistant
DATABASE_URL=postgresql+psycopg://assistant:CHANGE_ME@db:5432/assistant
# LLM (any OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Google Calendar (prompt 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# API (prompt 3)
ADMIN_API_KEY=
DEBUG=false
# Where downloaded voice files are stored inside the container
VOICE_DIR=/app/data/voice
